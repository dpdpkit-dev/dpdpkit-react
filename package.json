{
  "name": "@dpdpkit/react",
  "version": "0.1.0-alpha.1",
  "description": "React components and hooks for dpdpkit: DPDP consent notice, preference centre, rights request form.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpdpkit-dev/dpdpkit-react.git"
  },
  "keywords": [
    "dpdp",
    "consent",
    "privacy",
    "react",
    "india",
    "cookie-consent"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@dpdpkit/client": ">=0.1.0-0 <0.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@dpdpkit/client": "file:../dpdpkit-client",
    "@testing-library/react": "^16.0.0",
    "@testing-library/dom": "^10.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.10.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
